---
import { formatDecimal, formatNumber, formatPercent } from '../../lib/report/format';
import type { QueryRow } from '../../lib/report/types';

interface Props {
  caption: string;
  rows: QueryRow[];
  emptyMessage?: string;
}

const { caption, rows, emptyMessage = 'Nessuna ricerca registrata in questa settimana.' } = Astro.props;
---

{
  rows.length === 0 ? (
    <p class="text-sm text-muted">{emptyMessage}</p>
  ) : (
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <caption class="sr-only">{caption}</caption>
        <thead>
          <tr class="border-b-2 border-fg text-left">
            <th scope="col" class="py-2 pr-fluid-3 font-semibold">Ricerca</th>
            <th scope="col" class="py-2 px-fluid-2 text-right font-semibold">Clic</th>
            <th scope="col" class="py-2 px-fluid-2 text-right font-semibold">Viste</th>
            <th scope="col" class="py-2 px-fluid-2 text-right font-semibold">CTR</th>
            <th scope="col" class="py-2 pl-fluid-2 text-right font-semibold">Posizione</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-border">
              <th scope="row" class="py-2 pr-fluid-3 text-left font-normal break-words">
                {row.query}
              </th>
              <td class="py-2 px-fluid-2 text-right tabular-nums font-semibold">{formatNumber(row.clicks)}</td>
              <td class="py-2 px-fluid-2 text-right tabular-nums">{formatNumber(row.impressions)}</td>
              <td class="py-2 px-fluid-2 text-right tabular-nums">{formatPercent(row.ctr, 1)}</td>
              <td class="py-2 pl-fluid-2 text-right tabular-nums">{formatDecimal(row.position, 1)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
