---
import { formatDecimal, formatNumber } from '../../lib/report/format';
import type { Opportunity } from '../../lib/report/types';

interface Props {
  items: Opportunity[];
  emptyMessage: string;
  showPotential?: boolean;
}

const { items, emptyMessage, showPotential = true } = Astro.props;
---

{
  items.length === 0 ? (
    <p class="text-sm text-muted">{emptyMessage}</p>
  ) : (
    <ol class="flex flex-col gap-fluid-3">
      {items.map((item, index) => (
        <li class="rounded-md border-2 border-fg bg-bg p-fluid-3">
          <div class="flex flex-wrap items-start justify-between gap-fluid-2">
            <h3 class="text-base font-semibold break-words">
              <span class="mr-2 text-muted tabular-nums">{index + 1}.</span>
              {item.query}
            </h3>
            {showPotential && item.potentialClicks >= 1 && (
              <span class="shrink-0 rounded-sm bg-yellow px-2 py-0.5 text-xs font-semibold text-blue">
                +{formatNumber(Math.round(item.potentialClicks))} clic stimati
              </span>
            )}
          </div>
          <p class="mt-fluid-2 text-sm">{item.reason}</p>
          <p class="mt-fluid-1 text-sm text-muted">{item.action}</p>
          <p class="mt-fluid-2 text-xs text-muted tabular-nums">
            {formatNumber(item.impressions)} viste · {formatNumber(item.clicks)} clic · posizione media{' '}
            {formatDecimal(item.position, 1)}
          </p>
        </li>
      ))}
    </ol>
  )
}
