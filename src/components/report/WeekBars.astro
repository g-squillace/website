---
import { formatNumber } from '../../lib/report/format';
import type { DailyPoint } from '../../lib/report/types';

interface Props {
  points: DailyPoint[];
  metric: 'sessions' | 'clicks';
  title: string;
  description: string;
}

const { points, metric, title, description } = Astro.props;
const peak = points.reduce((max, point) => Math.max(max, point[metric]), 0);
const total = points.reduce((sum, point) => sum + point[metric], 0);
---

<section class="rounded-lg border-2 border-fg bg-bg p-fluid-4">
  <div class="mb-fluid-3 flex flex-wrap items-baseline justify-between gap-fluid-2">
    <h3 class="text-base font-semibold">{title}</h3>
    <p class="text-sm text-muted">{description}</p>
  </div>

  {
    total === 0 ? (
      <p class="text-sm text-muted">Nessun dato registrato in questi sette giorni.</p>
    ) : (
      <ol class="flex items-end justify-between gap-fluid-1 h-40">
        {points.map((point) => {
          const height = peak > 0 ? Math.max(3, (point[metric] / peak) * 100) : 3;
          return (
            <li class="flex h-full min-w-0 flex-1 flex-col items-center justify-end gap-1">
              <span class="text-xs tabular-nums font-semibold">{formatNumber(point[metric])}</span>
              <span
                class="w-full rounded-t-sm bg-orange"
                style={`height: ${height}%`}
                aria-hidden="true"
              />
              <span class="text-xs text-muted">{point.weekdayLabel}</span>
            </li>
          );
        })}
      </ol>
    )
  }
</section>
