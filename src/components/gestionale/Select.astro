---
interface Props {
  id: string;
  name: string;
  label: string;
  value?: string | null;
  options: ReadonlyArray<{ value: string; label: string }>;
  placeholder?: string;
}

const { id, name, label, value, options, placeholder } = Astro.props;
---

<div class="flex flex-col gap-fluid-1">
  <label for={id} class="text-sm font-semibold">{label}</label>
  <select
    id={id}
    name={name}
    class="min-h-11 w-full rounded-md border-2 border-fg bg-bg px-fluid-3 py-fluid-2"
  >
    {placeholder !== undefined && <option value="">{placeholder}</option>}
    {
      options.map((option) => (
        <option value={option.value} selected={option.value === (value ?? '')}>
          {option.label}
        </option>
      ))
    }
  </select>
</div>
