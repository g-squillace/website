---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, CONTACT } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'profile';
}

const netlifyContext = process.env.CONTEXT;
const isPreviewContext = Boolean(netlifyContext && netlifyContext !== 'production');

const {
  title,
  description = SITE.description,
  image,
  imageAlt,
  noindex = isPreviewContext,
  ogType = 'website',
} = Astro.props;

const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();

const ogImage = image
  ? {
      url: new URL(image, Astro.site ?? SITE.url).toString(),
      width: undefined as number | undefined,
      height: undefined as number | undefined,
      type: undefined as string | undefined,
      alt: imageAlt ?? fullTitle,
    }
  : {
      url: new URL(SITE.ogImage.path, Astro.site ?? SITE.url).toString(),
      width: SITE.ogImage.width as number | undefined,
      height: SITE.ogImage.height as number | undefined,
      type: SITE.ogImage.type as string | undefined,
      alt: SITE.ogImage.alt,
    };

const personLd = {
  '@type': 'Person',
  '@id': `${SITE.url}/#person`,
  name: SITE.author,
  url: `${SITE.url}/`,
  image: new URL(SITE.ogImage.path, SITE.url).toString(),
  jobTitle: 'Sviluppatore web frontend',
  email: `mailto:${CONTACT.email}`,
  description: SITE.description,
  knowsAbout: [
    'Sviluppo web',
    'Astro',
    'Next.js',
    'TypeScript',
    'DatoCMS',
    'Headless CMS',
    'E-commerce',
    'Accessibilità web',
  ],
  workLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Siena',
      addressRegion: 'Toscana',
      addressCountry: 'IT',
    },
  },
};

const serviceLd = {
  '@type': 'Service',
  '@id': `${SITE.url}/#service`,
  serviceType: 'Sviluppo di siti web e applicazioni su misura',
  provider: { '@id': `${SITE.url}/#person` },
  areaServed: [
    { '@type': 'City', name: 'Siena' },
    { '@type': 'Country', name: 'Italia' },
  ],
};

const websiteLd = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: `${SITE.url}/`,
  name: SITE.name,
  description: SITE.description,
  inLanguage: SITE.locale,
  publisher: { '@id': `${SITE.url}/#person` },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [personLd, websiteLd, serviceLd],
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://cdn.iubenda.com" crossorigin />
    <link rel="preconnect" href="https://cs.iubenda.com" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ff5354" />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="application-name" content={SITE.name} />

    <link
      rel="preload"
      href="/fonts/Figtree/Figtree-VariableFont_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dazzle_Unicase_Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="author" content={SITE.author} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage.url} />
    <meta property="og:image:alt" content={ogImage.alt} />
    {ogImage.width && <meta property="og:image:width" content={String(ogImage.width)} />}
    {ogImage.height && <meta property="og:image:height" content={String(ogImage.height)} />}
    {ogImage.type && <meta property="og:image:type" content={ogImage.type} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.url} />
    <meta name="twitter:image:alt" content={ogImage.alt} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500,
      });

      window._iub = window._iub || [];
      window._iub.csConfiguration = {
        siteId: 4537765,
        cookiePolicyId: 16220679,
        lang: 'it',
        whitelabel: true,
        askConsentAtCookiePolicyUpdate: true,
        countryDetection: true,
        enableFadp: true,
        enableLgpd: true,
        lgpdAppliesGlobally: false,
        perPurposeConsent: true,
        banner: {
          acceptButtonDisplay: true,
          closeButtonDisplay: false,
          customizeButtonDisplay: true,
          explicitWithdrawal: true,
          listPurposes: true,
          position: 'float-bottom-center',
          rejectButtonDisplay: true,
          showTitle: false,
          backgroundColor: '#ffb5d2',
          textColor: '#ffffff',
          acceptButtonColor: '#ffb5d2',
          acceptButtonCaptionColor: '#0900ff',
          customizeButtonColor: '#ffb5d2',
          customizeButtonCaptionColor: '#0900ff',
          rejectButtonColor: '#ffb5d2',
          rejectButtonCaptionColor: '#111111',
        },
        callback: {
          onPreferenceExpressedOrNotNeeded: function (preference) {
            applyConsent(preference);
          },
        },
      };
      window._iub.csLangConfiguration = { it: { cookiePolicyId: 16220679 } };

      var GA_MEASUREMENT_ID = 'G-C6KMJ4K1MV';
      var isGoogleTagLoaded = false;

      function hasPurposeConsent(preference, purposeId) {
        if (!preference) return false;
        if (preference.purposes) return preference.purposes[purposeId] === true;
        return preference.consent === true;
      }

      function toConsentState(isGranted) {
        return isGranted ? 'granted' : 'denied';
      }

      function applyConsent(preference) {
        var isMeasurementGranted = hasPurposeConsent(preference, '4');
        var isAdvertisingGranted = hasPurposeConsent(preference, '5');

        window['ga-disable-' + GA_MEASUREMENT_ID] = !isMeasurementGranted;
        gtag('consent', 'update', {
          ad_storage: toConsentState(isAdvertisingGranted),
          ad_user_data: toConsentState(isAdvertisingGranted),
          ad_personalization: toConsentState(isAdvertisingGranted),
          analytics_storage: toConsentState(isMeasurementGranted),
          functionality_storage: toConsentState(hasPurposeConsent(preference, '2')),
          personalization_storage: toConsentState(hasPurposeConsent(preference, '3')),
        });

        if (isMeasurementGranted) {
          loadGoogleTag();
        } else {
          removeGoogleAnalyticsCookies();
        }
      }

      function isGoogleAnalyticsCookie(name) {
        return name === '_ga' || name.indexOf('_ga_') === 0;
      }

      function removeGoogleAnalyticsCookies() {
        var cookieNames = document.cookie
          .split(';')
          .map(function (cookie) { return cookie.split('=')[0].trim(); })
          .filter(isGoogleAnalyticsCookie);
        if (cookieNames.length === 0) return;

        var hostLabels = location.hostname.split('.');
        var cookieDomains = [''];
        for (var i = 0; i < hostLabels.length - 1; i++) {
          cookieDomains.push('; domain=' + hostLabels.slice(i).join('.'));
        }

        cookieNames.forEach(function (name) {
          cookieDomains.forEach(function (domain) {
            document.cookie = name + '=; Max-Age=0; path=/' + domain;
          });
        });
      }

      function loadGoogleTag() {
        if (isGoogleTagLoaded) return;
        isGoogleTagLoaded = true;
        gtag('js', new Date());
        gtag('config', GA_MEASUREMENT_ID);
        var gtm = document.createElement('script');
        gtm.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
        gtm.async = true;
        document.head.appendChild(gtm);
      }

      function loadIubenda() {
        var iub = document.createElement('script');
        iub.src = 'https://cdn.iubenda.com/cs/iubenda_cs.js';
        iub.async = true;
        iub.charset = 'UTF-8';
        document.head.appendChild(iub);
      }

      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadIubenda, { timeout: 2500 });
      } else {
        window.addEventListener('load', function () {
          setTimeout(loadIubenda, 200);
        });
      }
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-100 focus:bg-fg focus:text-bg focus:px-4 focus:py-2 focus:no-underline"
    >
      Salta al contenuto
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style is:inline>
      @property --tw-translate-x { syntax: "<length-percentage>"; inherits: false; initial-value: 0; }
      @property --tw-translate-y { syntax: "<length-percentage>"; inherits: false; initial-value: 0; }
      @property --tw-translate-z { syntax: "<length>"; inherits: false; initial-value: 0; }
      @property --tw-rotate-x { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
      @property --tw-rotate-y { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
      @property --tw-rotate-z { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
      @property --tw-skew-x { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
      @property --tw-skew-y { syntax: "<angle>"; inherits: false; initial-value: 0deg; }
      @property --tw-scale-x { syntax: "<number>"; inherits: false; initial-value: 1; }
      @property --tw-scale-y { syntax: "<number>"; inherits: false; initial-value: 1; }
      @property --tw-scale-z { syntax: "<number>"; inherits: false; initial-value: 1; }
    </style>
  </body>
</html>
