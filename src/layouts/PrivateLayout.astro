---
import '../styles/global.css';
import { PRIVATE_AREA, SITE } from '../config';

interface Props {
  title: string;
  section?: string;
  showLogout?: boolean;
  note?: string;
}

const {
  title,
  section,
  showLogout = false,
  note = 'Pagina privata, non indicizzata.',
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/Figtree/Figtree-VariableFont_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title} — {SITE.name}</title>
  </head>
  <body class="bg-surface">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-100 focus:bg-fg focus:text-bg focus:px-4 focus:py-2"
    >
      Salta al contenuto
    </a>

    <header class="border-b-2 border-fg bg-bg">
      <div class="page flex flex-wrap items-center justify-between gap-fluid-3 py-fluid-3">
        <p class="font-display text-lg">
          <a href={PRIVATE_AREA.path} class="underline-offset-4 hover:underline">{SITE.name}</a>
          {section !== undefined && <span class="text-muted font-sans text-sm font-normal"> / {section}</span>}
        </p>

        <div class="flex flex-wrap items-center gap-fluid-2">
          <slot name="nav" />
          {
            showLogout && (
              <form method="POST" action="/api/report/logout">
                <button
                  type="submit"
                  class="min-h-11 rounded-md border-2 border-fg px-fluid-3 py-fluid-1 text-sm font-semibold transition-soft hover:bg-fg hover:text-bg"
                >
                  Esci
                </button>
              </form>
            )
          }
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="page py-fluid-5 text-sm text-muted">
      <p>{note}</p>
    </footer>
  </body>
</html>
